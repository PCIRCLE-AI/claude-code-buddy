{
  "name": "@pcircle/memesh",
  "version": "4.2.11",
  "description": "MeMesh — Local memory for Claude Code and MCP coding agents. One SQLite file, zero cloud required.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "memesh": "dist/transports/cli/cli.js",
    "memesh-mcp": "dist/mcp/launcher.js",
    "memesh-http": "dist/transports/http/server.js",
    "memesh-view": "dist/cli/view.js"
  },
  "files": [
    "dist/",
    "dashboard/dist/",
    ".mcp.json",
    "hooks/hooks.json",
    "scripts/hooks/",
    "scripts/postinstall-rebuild.mjs",
    "scripts/upgrade-plugin.sh",
    "skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-rebuild.mjs",
    "build": "node scripts/check-schema-drift.mjs && tsc && node scripts/generate-hook-core.mjs && node scripts/copy-cli-assets.mjs && node scripts/set-executable-bits.mjs && node scripts/generate-skills-manifest.mjs && npm run build:dashboard && node scripts/smoke-test.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "test": "vitest",
    "test:e2e-dashboard": "node scripts/dashboard-e2e-smoke.mjs",
    "test:packaged": "node scripts/smoke-packed-artifact.mjs",
    "audit:prod": "node scripts/check-consumer-audit.mjs",
    "verify:release": "node scripts/check-version-coherence.mjs && node scripts/check-generated-mirror.mjs && npm run audit:prod",
    "prepublishOnly": "npm run build && npm run verify:release && npm test -- --run && npm run test:packaged",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/ --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ --fix",
    "start": "node dist/mcp/launcher.js",
    "bench:longmemeval": "node benchmarks/longmemeval/run.mjs --mode A --dataset /tmp/longmemeval_s.json"
  },
  "author": "PCIRCLE-AI",
  "license": "MIT",
  "homepage": "https://pcircle.ai/memesh-llm-memory",
  "bugs": {
    "url": "https://github.com/PCIRCLE-AI/memesh-llm-memory/issues"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "model-context-protocol",
    "memory",
    "sqlite",
    "knowledge-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PCIRCLE-AI/memesh-llm-memory.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.5.1",
    "sqlite-vec": "^0.1.9",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@protobufjs/utf8": "^1.1.2",
    "adm-zip": "^0.6.0",
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.4",
    "hono": "^4.12.32",
    "postcss": "^8.5.25",
    "protobufjs": "^7.6.5",
    "qs": "^6.15.3",
    "sharp": "^0.35.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "25.6.2",
    "eslint": "^10.3.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
